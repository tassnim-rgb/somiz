# Exclusions for Vercel project uploads (gitignore is NOT reliably honored
# by the Vercel CLI; keep this list authoritative for what ships to the build).
# The API service regenerates data/somiz.db itself via seed_database.py.
#
# NOTE: do NOT add blanket extension rules like `*.html` or `*.pdf` here.
# `*.html` would also exclude frontend/index.html (the Vite entry) and break
# the web build with [UNRESOLVED_ENTRY]. Exclude directories, not extensions.

# Local dev / Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Generated data & model artifacts (regenerated on the Vercel build)
data/generated/
data/somiz.db
data/*.sqlite3
models/artifacts/
reports/
experiments/

# Frontend build + deps (the `web` service installs and builds its own)
frontend/node_modules/
frontend/dist/
node_modules/

# Docs not needed at runtime
docs/

# Env / secrets
.env
.env.local