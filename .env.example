# Environment template — copy to `.env` (which is gitignored) and fill in.
# NEVER commit real secrets.

# --- Database ---
# SQLite file location override (default: data/somiz.db beside the repo
# root). The backend auto-loads this file at startup; values already set in
# the real environment always win over this file.
# SOMIZ_DB=data/somiz.db

# --- Simulation ---
# Master seed for the synthetic data engine (reproducibility)
SOMIZ_SIM_SEED=42

# --- Future: telemetry bridge (NOT IMPLEMENTED — placeholder for real data) ---
# SOMIZ_TELEMETRY_ENDPOINT=opc.tcp://localhost:4840
# SOMIZ_TELEMETRY_MODE=off          # off | simulated | real

# --- Future: LLM / external services (Phase 9 reports — optional) ---
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=
